<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manutenção do caminhão"
        android:textColor="@color/azul_marinho"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_dialogo">

                <EditText
                    android:id="@+id/edtData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Data da manutenção"
                    android:focusable="false"
                    android:clickable="true"
                    android:background="@drawable/bg_cards"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"
                    android:padding="14dp"/>

                <EditText
                    android:id="@+id/edtDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descrição da manutenção"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:gravity="top"
                    android:background="@drawable/bg_cards"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"
                    android:padding="14dp"
                    android:layout_marginTop="10dp"/>

                <EditText
                    android:id="@+id/edtValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Valor (R$)"
                    android:inputType="number"
                    android:background="@drawable/bg_cards"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"
                    android:padding="14dp"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/btnSalvar"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:text="Salvar manutenção"
                    android:textSize="18sp"
                    android:textColor="@color/branco"
                    android:backgroundTint="@color/azul_marinho"
                    android:layout_marginTop="16dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico de manutenções"
                android:textColor="@color/azul_marinho"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/containerHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>