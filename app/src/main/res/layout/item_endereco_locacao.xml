<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cards"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtDescricaoEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Principal"
        android:textColor="@color/azul_marinho"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDetalhesEndereco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rua, número, bairro e cidade"
        android:textColor="@color/cinza_hint"
        android:textSize="14sp" />

</LinearLayout>