<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Detalhes do cliente"
            android:textColor="@color/azul_marinho"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Dados pessoais do cliente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome completo"
                android:textColor="@color/cinza_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtNomeCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/preto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apelido"
                android:textColor="@color/cinza_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtApelidoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Telefone"
                android:textColor="@color/cinza_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTelefoneCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/preto"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Documento"
                android:textColor="@color/cinza_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDocumentoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/preto"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Endereços cadastrados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dialog"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Endereços cadastrados"
                android:textColor="@color/azul_marinho"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSemEnderecos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nenhum endereço cadastrado."
                android:textColor="@color/cinza_hint"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/containerEnderecos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btnAdicionarEndereco"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/azul_marinho"
                android:text="Adicionar endereço"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btnEditarEndereco"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/azul_marinho"
                android:text="Editar endereço"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="21sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Botões de ação -->
        <Button
            android:id="@+id/btnNovaLocacao"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/azul_marinho"
            android:text="Nova locação"
            android:textColor="@color/branco"
            android:textSize="21sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnEditarCliente"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/azul_marinho"
            android:text="Editar cliente"
            android:textColor="@color/branco"
            android:textSize="21sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnInativarCliente"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#D32F2F"
            android:text="Inativar cliente"
            android:textColor="@color/branco"
            android:textSize="21sp"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>