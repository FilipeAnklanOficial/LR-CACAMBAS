<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LR Caçambas"
        android:textColor="@color/azul_marinho"
        android:textSize="45sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnClientes"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Clientes"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/btnLocacoes"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Locações"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/btnClientes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnRecebimentos"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Recebimentos"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/btnLocacoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnCacambas"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Caçambas"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/btnRecebimentos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

    <Button
        android:id="@+id/btnDespesas"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Despesas"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/btnCacambas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>