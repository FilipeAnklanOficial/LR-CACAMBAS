<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTituloClientes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clientes"
        android:textColor="@color/azul_marinho"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnBuscarCliente"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Buscar cliente"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/txtTituloClientes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <Button
        android:id="@+id/btnCadastrarCliente"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Cadastrar cliente"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        app:layout_constraintTop_toBottomOf="@id/btnBuscarCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>