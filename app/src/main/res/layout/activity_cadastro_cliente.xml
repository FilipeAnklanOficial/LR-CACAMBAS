<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_cadastro_cliente"
            android:textColor="@color/azul_marinho"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome completo *"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtNomeCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Digite o nome do cliente"
            android:textSize="18sp"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone *"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtTelefoneCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Digite o telefone"
            android:textSize="18sp"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint"
            android:inputType="phone"
            android:maxLength="15"
            android:padding="12dp"
            android:background="@color/branco" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documento (opcional)"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtDocumentoCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="CPF ou CNPJ"
            android:textSize="18sp"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint"
            android:inputType="number"
            android:maxLength="18"
            android:padding="12dp"
            android:background="@color/branco" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apelido (opcional)"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            />

        <EditText
            android:id="@+id/edtApelidoCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Como o cliente é conhecido?"
            android:textSize="18sp"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint"/>

        <TextView
            android:id="@+id/txtTituloEnderecoPrincipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endereço principal"
            android:textColor="@color/azul_marinho"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logradouro *"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtLogradouroCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Rua, avenida, estrada..."
            android:textSize="18sp"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtNumeroEnderecoCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Número do imóvel"
            android:textSize="18sp"
            android:inputType="text"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bairro *"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtBairroCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Digite o bairro"
            android:textSize="18sp"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cidade *"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtCidadeCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Digite a cidade"
            android:textSize="18sp"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complemento (opcional)"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtComplementoCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Casa, apartamento..."
            android:textSize="18sp"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ponto de referência (opcional)"
            android:textColor="@color/preto"
            android:textSize="18sp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtReferenciaCliente"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Próximo a..."
            android:textSize="18sp"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:background="@color/branco"
            android:textColor="@color/preto"
            android:textColorHint="@color/cinza_hint" />

        <Button
            android:id="@+id/btnSalvarCliente"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:text="@string/salvar"
            android:textColor="@color/branco"
            android:textSize="21sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/azul_marinho"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnCancelarCliente"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:text="@string/cancelar"
            android:textColor="@color/branco"
            android:textSize="21sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/azul_marinho"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>