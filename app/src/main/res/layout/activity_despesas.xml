<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Despesas"
        android:textColor="@color/azul_marinho"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnCombustivel"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Combustível"
        android:textColor="@color/branco"
        android:textSize="21sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnManutencaoCaminhao"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Manutenção do caminhão"
        android:textColor="@color/branco"
        android:textSize="19sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnCombustivel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnManutencaoCacambas"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:text="Manutenção das caçambas"
        android:textColor="@color/branco"
        android:textSize="19sp"
        android:textAllCaps="false"
        android:backgroundTint="@color/azul_marinho"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnManutencaoCaminhao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>