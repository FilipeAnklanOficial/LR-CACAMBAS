<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialogo">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trocar caçamba"
        android:textColor="@color/azul_marinho"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/txtCacambaAtualTroca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Caçamba atual: #001"
        android:textColor="@color/preto"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nova caçamba"
        android:textColor="@color/azul_marinho"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerNovaCacamba"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_cards"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motivo da troca"
        android:textColor="@color/azul_marinho"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerMotivoTroca"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_cards"
        android:padding="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Valor adicional (R$)"
        android:textColor="@color/azul_marinho"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtValorAdicionalTroca"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_cards"
        android:hint="0,00"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:text="0,00"
        android:textColor="#000000"
        android:textColorHint="#666666"
        android:textSize="17sp"
        android:alpha="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Observação (opcional)"
        android:textColor="@color/azul_marinho"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtObservacaoTroca"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_cards"
        android:gravity="top|start"
        android:hint="Informe uma observação, se necessário"
        android:inputType="textCapSentences|textMultiLine"
        android:padding="12dp"
        android:textColor="#333333"
        android:textColorHint="#777777"
        android:textSize="16sp"
        android:alpha="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelarTroca"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="@color/branco"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/preto"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnConfirmarTroca"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:backgroundTint="@color/azul_marinho"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>