<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalhes da locação"
            android:textColor="@color/azul_marinho"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Informações do cliente -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_cards"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtNomeCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do cliente"
                android:textColor="@color/azul_marinho"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEnderecoLocacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Endereço da locação"
                android:textColor="@color/cinza_hint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtDataInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Início da locação"
                android:textColor="@color/cinza_hint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtStatusLocacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Status"
                android:textColor="@color/azul_marinho"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Resumo financeiro -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Resumo financeiro"
            android:textColor="@color/azul_marinho"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_cards"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Valor atual"
                        android:textColor="@color/cinza_hint"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtValorAtual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textColor="@color/azul_marinho"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saldo pendente"
                        android:textColor="@color/cinza_hint"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtSaldoPendente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textColor="@color/azul_marinho"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Valor recebido"
                        android:textColor="@color/cinza_hint"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtValorRecebido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textColor="@color/azul_marinho"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total de pagamentos"
                        android:textColor="@color/cinza_hint"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTotalPagamentos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/azul_marinho"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Histórico de caçambas -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Histórico de caçambas"
            android:textColor="@color/azul_marinho"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerHistoricoCacambas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnTrocarCacamba"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/azul_marinho"
            android:text="Realizar troca de caçamba"
            android:textColor="@color/branco"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center" />

        <!-- Histórico de recebimentos -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Histórico de recebimentos"
            android:textColor="@color/azul_marinho"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerHistoricoRecebimentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Histórico de ajustes -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Histórico de ajustes"
            android:textColor="@color/azul_marinho"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/containerHistoricoAjustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>