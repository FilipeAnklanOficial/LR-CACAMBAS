<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Combustível"
        android:textColor="@color/azul_marinho"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Média histórica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_dialogo">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Média histórica do caminhão"
                    android:textColor="@color/azul_marinho"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMediaHistorica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Média ainda indisponível"
                    android:textColor="@color/preto"
                    android:textSize="20sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Formulário -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_dialogo">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Novo abastecimento"
                    android:textColor="@color/azul_marinho"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/edtData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Data do abastecimento"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"
                    android:background="@drawable/bg_cards"
                    android:padding="14dp" />

                <EditText
                    android:id="@+id/edtQuilometragem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Quilometragem (KM)"
                    android:inputType="number"
                    android:background="@drawable/bg_cards"
                    android:padding="14dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"/>

                <EditText
                    android:id="@+id/edtLitros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Litros (00,00)"
                    android:inputType="number"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"
                    android:background="@drawable/bg_cards"
                    android:padding="14dp"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/edtValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Valor (R$ 00,00)"
                    android:inputType="number"
                    android:textColor="@color/preto"
                    android:textColorHint="@color/cinza_hint"
                    android:background="@drawable/bg_cards"
                    android:padding="14dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O tanque foi completado?"
                    android:textColor="@color/preto"
                    android:textSize="16sp"
                    android:layout_marginTop="14dp" />

                <RadioGroup
                    android:id="@+id/rgTanqueCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbTanqueSim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sim"
                        android:textColor="@color/preto" />

                    <RadioButton
                        android:id="@+id/rbTanqueNao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Não"
                        android:layout_marginStart="24dp"
                        android:textColor="@color/preto" />

                </RadioGroup>

                <Button
                    android:id="@+id/btnSalvarAbastecimento"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:text="Salvar abastecimento"
                    android:textColor="@color/branco"
                    android:textSize="18sp"
                    android:backgroundTint="@color/azul_marinho"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- Histórico -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico de abastecimentos"
                android:textColor="@color/azul_marinho"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/containerHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>