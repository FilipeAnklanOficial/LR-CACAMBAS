<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_botao_dialogo_secundario"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtCodigoCacamba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Caçamba 001"
        android:textColor="@color/azul_marinho"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStatusCacamba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Situação: Disponível"
        android:textColor="@color/preto"
        android:textSize="16sp" />

</LinearLayout>