<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarelo_principal"
    android:fillViewport="true"
    tools:context=".AbrirLocacaoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Abrir locação"
            android:textColor="@color/azul_marinho"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialogo"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dados da locação"
                android:textColor="@color/azul_marinho"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Cliente"
                android:textColor="@color/azul_marinho"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtClienteSelecionado"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cards"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="Selecione um cliente"
                android:textColor="@color/cinza_hint"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Endereço de entrega"
                android:textColor="@color/azul_marinho"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEnderecoSelecionado"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cards"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:text="Selecione um endereço"
                android:textColor="@color/cinza_hint"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Valor da locação (R$)"
                android:textColor="@color/azul_marinho"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtValorInicial"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cards"
                android:hint="Informe o valor da locação"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/preto"
                android:textColorHint="@color/cinza_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Caçamba"
                android:textColor="@color/azul_marinho"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCacamba"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cards"
                android:paddingHorizontal="12dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Observações (opcional)"
                android:textColor="@color/azul_marinho"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtObservacoes"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cards"
                android:gravity="top|start"
                android:hint="Informe alguma observação, se necessário"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="@color/preto"
                android:textColorHint="@color/cinza_hint" />

            <Button
                android:id="@+id/btnSalvarLocacao"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/azul_marinho"
                android:text="Abrir locação"
                android:textColor="@color/branco"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/azul_marinho"
                android:text="Cancelar"
                android:textColor="@color/branco"
                android:textSize="21sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>