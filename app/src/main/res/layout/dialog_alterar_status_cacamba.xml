<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialogo">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alterar situação"
        android:textColor="@color/azul_marinho"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Selecione a nova situação da caçamba:"
        android:textColor="@color/cinza_hint"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnStatusOpcao1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="@color/amarelo_principal"
        android:textColor="@color/azul_marinho"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStatusOpcao2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#D32F2F"
        android:textColor="@color/branco"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnCancelarStatus"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="12dp"
        android:text="CANCELAR"
        android:textColor="@color/azul_marinho"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>